<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件：浅色卡片，字少；点整块打开 App -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/sayday_widget_bg">

    <TextView
        android:id="@+id/w_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="日日说"
        android:textColor="#1A6DFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="打开 App 开始今天的练习"
        android:textColor="#0F1B33"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#5B6679"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/w_word_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/w_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0F1B33"
            android:textSize="16sp"
            android:fontFamily="serif"
            android:maxLines="1" />

        <TextView
            android:id="@+id/w_meaning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8F99AA"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
