<?xml version="1.0" encoding="utf-8"?>
<!-- 单词卡（4×2）：词 + 音标 + 换一个；意思；例句（英文 + 中文）贴底，中间弹性空白 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/sayday_widget_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/w_word" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="word" android:textColor="@color/sayday_w_on_mark" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:background="@drawable/sayday_widget_mark" android:paddingStart="6dp" android:paddingEnd="6dp"/>
<TextView android:id="@+id/w_ipa" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="" android:textColor="@color/sayday_w_faint" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
<TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:text="换一个" android:textColor="@color/sayday_w_ink" android:textSize="13sp" android:textStyle="bold" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/sayday_w_btn_soft" android:maxLines="1" />
</LinearLayout>
<TextView android:id="@+id/w_meaning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="学几个词，这里会出现在学的词" android:textColor="@color/sayday_w_ink" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="8dp"/>
<FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:minHeight="6dp" />
<TextView android:id="@+id/w_ex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/sayday_w_ink" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:fontFamily="serif" />
<TextView android:id="@+id/w_ex_zh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/sayday_w_faint" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
