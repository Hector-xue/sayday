<?xml version="1.0" encoding="utf-8"?>
<!-- 单词卡（4×2）：在学的词 + 音标 + 意思 + 例句；“换一个”看下一个 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/sayday_widget_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/w_word" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="word" android:textColor="@color/sayday_w_on_mark" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:background="@drawable/sayday_widget_mark" android:paddingStart="4dp" android:paddingEnd="4dp"/>
<TextView android:id="@+id/w_ipa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/sayday_w_faint" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="6dp"/>
<FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center" android:text="换一个" android:textColor="@color/sayday_w_ink" android:textSize="12sp" android:textStyle="bold" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/sayday_w_btn_soft" android:maxLines="1" />
</LinearLayout>
<TextView android:id="@+id/w_meaning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="学几个词，这里会出现在学的词" android:textColor="@color/sayday_w_ink" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
<TextView android:id="@+id/w_ex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/sayday_w_soft" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
