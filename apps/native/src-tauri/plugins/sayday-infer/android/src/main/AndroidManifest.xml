<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 跟读录音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 面对面同步：扫另一台设备上的二维码（没有摄像头也能手动输入） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 应用内更新：下载新版安装包后交给系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- AI 回复、日记朗读用系统 TTS；安卓 11+ 要声明才能找到语音引擎 -->
    <!-- 通知里做题：手机重启后把出题闹钟排回去 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application>
        <!-- 桌面小组件（六种，内容由 App 推送，见 Widgets.kt）。SaydayWidget 是最早那个，类名不能改 -->
        <receiver
            android:name="com.ivyea.sayday.infer.SaydayWeekWidget"
            android:exported="true"
            android:label="日日说 · 本周">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sayday_w_week_info" />
        </receiver>
        <receiver
            android:name="com.ivyea.sayday.infer.SaydayTodayWidget"
            android:exported="true"
            android:label="日日说 · 今天">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sayday_w_today_info" />
        </receiver>
        <receiver
            android:name="com.ivyea.sayday.infer.SaydayWordWidget"
            android:exported="true"
            android:label="日日说 · 单词卡">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sayday_w_word_info" />
        </receiver>
        <receiver
            android:name="com.ivyea.sayday.infer.SaydayEpisodeWidget"
            android:exported="true"
            android:label="日日说 · 今日剧集">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sayday_w_episode_info" />
        </receiver>
        <receiver
            android:name="com.ivyea.sayday.infer.SaydayMiniWidget"
            android:exported="true"
            android:label="日日说 · 开练">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sayday_w_mini_info" />
        </receiver>
        <receiver
            android:name="com.ivyea.sayday.infer.SaydayWidget"
            android:exported="true"
            android:label="日日说 · 综合">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sayday_widget_info" />
        </receiver>
        <!-- 通知里做题：到点弹题、接收按钮 / 快捷回复的答案、开机重排闹钟（见 Quiz.kt） -->
        <receiver
            android:name="com.ivyea.sayday.infer.QuizReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- 应用内更新：把缓存目录里的安装包交给系统安装器（见 Updater.kt） -->
        <provider
            android:name="com.ivyea.sayday.infer.UpdateFileProvider"
            android:authorities="${applicationId}.sayday.update"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/sayday_update_paths" />
        </provider>
    </application>
</manifest>
