<?xml version="1.0" encoding="utf-8"?>
<!-- 今日剧集（4×2）：第几集、标题、看点；去看 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/sayday_widget_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日剧集" android:textColor="@color/sayday_w_faint" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
<FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<TextView android:id="@+id/w_btn" android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center" android:text="去看" android:textColor="@color/sayday_w_bg" android:textSize="12sp" android:textStyle="bold" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/sayday_w_btn" android:maxLines="1" />
</LinearLayout>
<TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Life in London" android:textColor="@color/sayday_w_ink" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" android:fontFamily="serif"/>
<TextView android:id="@+id/w_zh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="一天一集，像追剧一样学英语" android:textColor="@color/sayday_w_soft" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
