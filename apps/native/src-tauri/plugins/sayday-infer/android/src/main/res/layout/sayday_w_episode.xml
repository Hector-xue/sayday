<?xml version="1.0" encoding="utf-8"?>
<!-- 今日剧集（4×2）：第几集 + 去看；标题和看点贴底，中间弹性空白 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/sayday_widget_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="今日剧集" android:textColor="@color/sayday_w_soft" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="8dp" />
<TextView android:id="@+id/w_btn" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:text="去看" android:textColor="@color/sayday_w_bg" android:textSize="14sp" android:textStyle="bold" android:paddingStart="18dp" android:paddingEnd="18dp" android:background="@drawable/sayday_w_btn" android:maxLines="1" />
</LinearLayout>
<FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:minHeight="6dp" />
<TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Life in London" android:textColor="@color/sayday_w_ink" android:textSize="22sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:fontFamily="serif"/>
<TextView android:id="@+id/w_zh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="一天一集，像追剧一样学英语" android:textColor="@color/sayday_w_soft" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
