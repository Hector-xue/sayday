<?xml version="1.0" encoding="utf-8"?>
<!-- 本周（4×2）：七天的点 + 今天的状态 + 开练。三段之间用弹性空白撑满整个高度（拉高了也不会下半截空着） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/sayday_widget_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/w_head" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本周练了 0/4 天" android:textColor="@color/sayday_w_on_mark" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:background="@drawable/sayday_widget_chip" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
<FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/sayday_w_faint" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:minHeight="6dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
<TextView android:id="@+id/w_d0_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="一" android:textColor="@color/sayday_w_faint" android:textSize="11sp" android:maxLines="1" />
<TextView android:id="@+id/w_d0" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="4dp" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sayday_w_on_mark" android:background="@drawable/sayday_w_dot_off" />
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
<TextView android:id="@+id/w_d1_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="二" android:textColor="@color/sayday_w_faint" android:textSize="11sp" android:maxLines="1" />
<TextView android:id="@+id/w_d1" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="4dp" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sayday_w_on_mark" android:background="@drawable/sayday_w_dot_off" />
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
<TextView android:id="@+id/w_d2_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="三" android:textColor="@color/sayday_w_faint" android:textSize="11sp" android:maxLines="1" />
<TextView android:id="@+id/w_d2" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="4dp" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sayday_w_on_mark" android:background="@drawable/sayday_w_dot_off" />
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
<TextView android:id="@+id/w_d3_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="四" android:textColor="@color/sayday_w_faint" android:textSize="11sp" android:maxLines="1" />
<TextView android:id="@+id/w_d3" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="4dp" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sayday_w_on_mark" android:background="@drawable/sayday_w_dot_off" />
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
<TextView android:id="@+id/w_d4_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="五" android:textColor="@color/sayday_w_faint" android:textSize="11sp" android:maxLines="1" />
<TextView android:id="@+id/w_d4" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="4dp" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sayday_w_on_mark" android:background="@drawable/sayday_w_dot_off" />
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
<TextView android:id="@+id/w_d5_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="六" android:textColor="@color/sayday_w_faint" android:textSize="11sp" android:maxLines="1" />
<TextView android:id="@+id/w_d5" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="4dp" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sayday_w_on_mark" android:background="@drawable/sayday_w_dot_off" />
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
<TextView android:id="@+id/w_d6_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日" android:textColor="@color/sayday_w_faint" android:textSize="11sp" android:maxLines="1" />
<TextView android:id="@+id/w_d6" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="4dp" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sayday_w_on_mark" android:background="@drawable/sayday_w_dot_off" />
</LinearLayout>
</LinearLayout>
<FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:minHeight="6dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/w_main" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今天还没练" android:textColor="@color/sayday_w_ink" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="累的话 2 分钟也算数" android:textColor="@color/sayday_w_soft" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<TextView android:id="@+id/w_btn" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:text="开练" android:textColor="@color/sayday_w_bg" android:textSize="14sp" android:textStyle="bold" android:paddingStart="18dp" android:paddingEnd="18dp" android:background="@drawable/sayday_w_btn" android:maxLines="1" />
</LinearLayout>
</LinearLayout>
